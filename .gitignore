# =============================================================================
# Flutter / Dart / Pub
# Applies to every member of the pub workspace: app/, apps/*/, packages/*/.
# Platform folders generated by `flutter create` keep their own .gitignore.
# https://dart.dev/tools/private-files
# =============================================================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE / editor
*.iml
*.ipr
*.iws
.idea/
# .vscode/ is intentionally kept: launch.json and tasks.json belong in VCS.

# Pub / Flutter generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/

# Build outputs. Anchored per project because /support/build/ contains tracked
# release/packaging assets that must stay in version control.
/app/build/
/apps/*/build/
/packages/*/build/
coverage/
dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/*.keystore
**/*.jks

# Xcode / CocoaPods / SwiftPM generated data
**/dgph
**/DerivedData/
**/Pods/
**/.symlinks/
**/xcuserdata/
**/Flutter/ephemeral/
**/flutter/ephemeral/

# FVM version cache; .fvmrc is tracked because it pins the Flutter version
.fvm/

# =============================================================================
# Repository-specific
# =============================================================================

# Rust workspace build output
/target/

# Linux AppImage staging
/app/AppDir
/app/appimage-build

# Refena inspector data
.refena_inspector/

# Signing keys and local environment files
/secrets

# Generated at build time by makepri (see support/scripts/compile_windows_msix_helper.ps1)
/support/build/msix/content/resources.pri

# Local reference material, not part of this project
ref/
