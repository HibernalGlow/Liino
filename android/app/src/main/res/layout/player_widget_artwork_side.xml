<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <!-- Full-bleed artwork on the right; its left edge fades into the card -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="187dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:scaleType="fitXY" />

    <include
        layout="@layout/widget_part_text_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="33dp"
        android:layout_marginRight="150dp" />

    <include
        layout="@layout/widget_part_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="19dp"
        android:layout_marginTop="95dp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_drawable" />
</FrameLayout>
